    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
